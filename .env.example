# This file is a template. Node does not load it automatically.
# Start with: node --env-file=.env src/index.js (Node 22+).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=livro_visa
DB_USER=livro
DB_PASSWORD=replace-with-database-password
DB_LOG_SQL=false

# npm run auth:migrate activates this after migration and initial Chefia setup.
AUTH_ENABLED=false
AUTH_COOKIE_SECURE=true
TRUST_PROXY=false
APP_URL=https://livro.example.gov.br

SMTP_HOST=smtp.example.gov.br
SMTP_PORT=587
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Livro VISA <livro@example.gov.br>

# The recovery destination is set by Chefia in /admin/access, not here.
