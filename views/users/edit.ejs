<%- include('../partials/header.ejs') %>
<%- include('../partials/navbar.ejs') %>
<link rel="stylesheet" href="/css/admin.css">
<link rel="stylesheet" href="/css/admin-staff.css">
<main class="container admin-panel">
    <%- include('../partials/pageHeading.ejs', {eyebrow:'ADMINISTRATIVO',title:'Editar fiscal',description:'Atualize o nome e a disponibilidade para receber atribuições.',actionHref:'/admin/fiscais',actionLabel:'Voltar aos fiscais'}) %>
    <%- include('../partials/adminTabs.ejs', {activeTab:'staff'}) %>
    <% if (locals.error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
    <section class="card admin-staff-edit"><div class="card-header"><h2 class="ui-section-title">Dados do fiscal <span class="small text-muted">#<%= user.id %></span></h2></div><div class="card-body">
        <form method="POST" action="/admin/fiscais/<%= user.id %>" data-admin-save>
            <div class="form-group"><label for="staff-edit-name">Nome do fiscal *</label><input id="staff-edit-name" class="form-control" type="text" name="name" maxlength="255" value="<%= user.name %>" required></div>
            <input type="hidden" name="activeState" value="explicit">
            <div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="staff-active" name="ativo" <%= user.ativo?'checked':'' %> aria-describedby="staff-state-help"><label class="form-check-label" for="staff-active">Fiscal ativo</label></div>
            <p id="staff-state-help" class="small text-muted">Fiscais inativos deixam de aparecer nas opções de atribuição. Seu histórico continua disponível.</p>
            <div class="admin-row-actions"><button class="btn btn-primary" type="submit">Salvar alterações</button><a class="btn btn-outline-secondary" href="/admin/fiscais">Cancelar</a></div>
        </form>
    </div></section>
</main>
<script src="/js/admin-staff.js" defer></script>
<%- include('../partials/footer.ejs') %>
