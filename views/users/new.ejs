<%- include('../partials/header.ejs') %>
<%- include('../partials/navbar.ejs') %>
<link rel="stylesheet" href="/css/admin.css">
<link rel="stylesheet" href="/css/admin-staff.css">
<main class="container admin-panel">
    <%- include('../partials/pageHeading.ejs', {eyebrow:'ADMINISTRATIVO',title:'Gerenciar fiscais',description:'Cadastre responsáveis e mantenha seus nomes e situações atualizados.',actionHref:'/area-fiscal',actionLabel:'Ver área do fiscal'}) %>
    <%- include('../partials/adminTabs.ejs', {activeTab:'staff'}) %>
    <% if (locals.success) { %><div class="alert alert-success" role="status"><%= success %></div><% } %>
    <% if (locals.error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
    <div class="admin-staff-layout">
        <section class="card" aria-labelledby="staff-create-title"><div class="card-header"><h2 id="staff-create-title" class="ui-section-title">Cadastrar fiscal</h2></div><div class="card-body">
            <form method="POST" action="/admin/fiscais" data-admin-save>
                <div class="form-group"><label for="staff-create-name">Nome do fiscal *</label><input id="staff-create-name" name="name" class="form-control" value="<%= formName %>" maxlength="255" required placeholder="Nome completo"></div>
                <p class="small text-muted">O novo fiscal será cadastrado como ativo e ficará disponível para atribuições.</p>
                <button type="submit" class="btn btn-primary">Cadastrar fiscal</button>
            </form>
        </div></section>
        <section class="card" aria-labelledby="staff-list-title"><div class="card-header admin-section-heading"><h2 id="staff-list-title" class="ui-section-title">Fiscais cadastrados</h2><span class="small text-muted"><%= username.length %> <%= username.length===1?'fiscal':'fiscais' %></span></div><div class="card-body">
            <div class="admin-list-filters"><div><label for="staff-search">Buscar fiscal</label><input id="staff-search" class="form-control" type="search" placeholder="Nome ou ID"></div><div><label for="staff-state">Situação</label><select id="staff-state" class="form-control"><option value="all">Todos</option><option value="active">Ativos</option><option value="inactive">Inativos</option></select></div></div>
            <p class="small text-muted" id="staff-filter-feedback" role="status" aria-live="polite"></p>
            <% if (username.length) { %><div class="table-responsive"><table class="table table-hover ui-responsive-table admin-staff-table"><thead><tr><th scope="col">ID</th><th scope="col">Nome</th><th scope="col">Situação</th><th scope="col">Ações</th></tr></thead><tbody>
                <% username.forEach(user=>{ %><tr data-staff-row data-name="<%= user.name %>" data-id="<%= user.id %>" data-active="<%= user.ativo?'true':'false' %>"><td data-label="ID"><%= user.id %></td><td data-label="Nome"><strong><%= user.name %></strong></td><td data-label="Situação"><span class="badge <%= user.ativo?'badge-success':'badge-secondary' %>"><%= user.ativo?'Ativo':'Inativo' %></span></td><td data-label="Ações"><div class="admin-row-actions"><a class="btn btn-sm btn-outline-secondary" href="/admin/fiscais/<%= user.id %>/edit">Editar</a><a class="btn btn-sm btn-outline-primary" href="/area-fiscal/<%= user.id %>?status=ALL">Ver denúncias</a></div></td></tr><% }) %>
            </tbody></table></div><% } else { %><p class="text-muted mb-0">Nenhum fiscal cadastrado. Use o formulário para adicionar o primeiro.</p><% } %>
        </div></section>
    </div>
</main>
<script src="/js/admin-staff.js" defer></script>
<%- include('../partials/footer.ejs') %>
