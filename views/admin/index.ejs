<%- include('../partials/header.ejs') %>
<%- include('../partials/navbar.ejs') %>
<link rel="stylesheet" href="/css/admin.css">
<main class="container admin-panel">
    <%- include('../partials/pageHeading.ejs', {eyebrow: 'ADMINISTRATIVO', title: 'Painel Administrativo', description: 'Acompanhe as denúncias, organize a fiscalização e gerencie o atendimento.', actionHref: '/admin/assignments', actionLabel: 'Atribuir fiscal', actionPrimary: true}) %>
    <%- include('../partials/adminTabs.ejs', {activeTab:tab,overviewUrl:adminUrl(filters),attendanceUrl:adminUrl(filters,{tab:'attendance'})}) %>
    <% if (notice) { %><div class="alert <%= noticeError ? 'alert-danger' : 'alert-success' %>" role="status"><%= notice %></div><% } %>
    <% if (tab === 'attendance') { %>
    <section class="card">
        <div class="card-header"><h2 class="ui-section-title">Configuração de atendimento de denúncias</h2></div>
        <div class="card-body">
        <p class="text-muted">Esta configuração aparece na página inicial e vale para todos os anos.</p>
        <form method="POST" action="/admin/attendance">
            <div class="form-check mb-2"><input class="form-check-input" id="attendance-disabled" type="checkbox" name="module_disabled" aria-describedby="attendance-module-help" <%= attendance.enabled === false ? 'checked' : '' %>><label class="form-check-label" for="attendance-disabled">Desabilitar módulo de atendimento</label></div>
            <p id="attendance-module-help" class="small text-muted">Oculta o bloco de atendimento na página inicial e preserva os dias configurados.</p>
            <fieldset id="attendance-options" <%= attendance.enabled === false ? 'disabled' : '' %>>
            <fieldset class="form-group"><legend class="h6">Dias de atendimento</legend><div class="d-flex flex-wrap">
                <% ['SEG','TER','QUA','QUI','SEX'].forEach(day => { %>
                <div class="form-check mr-4 mb-2"><input class="form-check-input" id="day-<%= day %>" type="checkbox" name="weekdays" value="<%= day %>" <%= attendance.weekdays.includes(day) ? 'checked' : '' %>><label class="form-check-label" for="day-<%= day %>"><%= day %></label></div>
                <% }) %>
            </div></fieldset>
            <div class="form-check mb-3"><input class="form-check-input" id="paused" type="checkbox" name="paused" <%= attendance.paused ? 'checked' : '' %>><label for="paused" class="form-check-label">Atendimento pausado</label></div>
            </fieldset>
            <button class="btn btn-primary">Salvar configuração</button>
        </form>
        <div class="alert alert-info mt-3 mb-0">Situação: <%= attendance.enabled === false ? 'Módulo de atendimento desabilitado' : attendance.paused ? 'Atendimento pausado' : attendance.weekdays.length ? 'Atendimento em ' + attendance.weekdays.join(', ') : 'Nenhum dia definido' %></div>
        <% if (attendance.updated_at) { %><small class="text-muted">Última alteração: <%= formatDate(attendance.updated_at) %></small><% } %>
    </div></section>
    <script src="/js/attendance.js" defer></script>
    <% } else { %>
    <form class="card mb-4 admin-filters" method="GET" action="/admin">
        <div class="card-header"><h2 class="ui-section-title">Filtros</h2></div>
        <div class="card-body"><div class="form-row">
            <div class="form-group col-sm-6 col-lg-2"><label for="year">Ano do protocolo</label><select id="year" name="year" class="form-control"><option value="">Todos os anos</option><% years.forEach(y => { %><option value="<%= y %>" <%= String(y) === filters.year ? 'selected' : '' %>><%= y %></option><% }) %></select></div>
            <div class="form-group col-sm-6 col-lg-2"><label for="scope">Situação</label><select id="scope" name="scope" class="form-control"><option value="all" <%= filters.scope === 'all' ? 'selected' : '' %>>Todas</option><option value="open" <%= filters.scope === 'open' ? 'selected' : '' %>>Somente abertas</option></select></div>
            <div class="form-group col-sm-6 col-lg-2"><label for="start">Registro a partir de</label><input class="form-control" type="date" id="start" name="start" value="<%= filters.start %>"></div>
            <div class="form-group col-sm-6 col-lg-2"><label for="end">Registro até</label><input class="form-control" type="date" id="end" name="end" value="<%= filters.end %>"></div>
            <div class="form-group col-sm-6 col-lg-4"><label for="userId">Fiscal</label><select class="form-control" id="userId" name="userId"><option value="">Todos</option><option value="unassigned" <%= filters.userId === 'unassigned' ? 'selected' : '' %>>Sem fiscal</option><% users.forEach(user => { %><option value="<%= user.id %>" <%= filters.userId === String(user.id) ? 'selected' : '' %>><%= user.name %><%= user.ativo ? '' : ' (inativo)' %></option><% }) %></select></div>
            <div class="form-group col-sm-6 col-lg-3"><label for="bairro">Bairro</label><select class="form-control" name="bairro" id="bairro"><option value="">Todos</option><% [...new Set([...districts.map(d => d.name), ...rows.map(r => r.bairro).filter(Boolean)])].sort().forEach(name => { %><option value="<%= name %>" <%= name === filters.bairro ? 'selected' : '' %>><%= name %></option><% }) %></select></div>
            <div class="form-group col-sm-6 col-lg-3"><label for="status">Status</label><select class="form-control" id="status" name="status"><option value="">Todos</option><% Object.entries(STATUS).forEach(([key, status]) => { %><option value="<%= key %>" <%= key === filters.status ? 'selected' : '' %>><%= status.label %></option><% }) %></select></div>
            <div class="form-group col-sm-6 col-lg-4"><label for="origin">Origem</label><select class="form-control" id="origin" name="registration_type"><option value="">Todas</option><% Object.entries(SENDERS).forEach(([slug, sender]) => { %><option value="<%= slug %>" <%= slug === filters.registration_type ? 'selected' : '' %>><%= sender %></option><% }) %></select></div>
            <div class="form-group col-sm-6 col-lg-2"><label for="inactivity">Sem relatório há</label><select class="form-control" id="inactivity" name="inactivityDays"><% [7,15,30,60].forEach(days => { %><option value="<%= days %>" <%= days === filters.inactivityDays ? 'selected' : '' %>><%= days %> dias</option><% }) %></select></div>
        </div>
        <button class="btn btn-success">Aplicar filtros</button> <a class="btn btn-outline-secondary" href="/admin">Limpar filtros</a>
        <a class="btn btn-outline-primary" href="/admin?scope=open">Todas as abertas, de todos os anos</a>
        <p class="small text-muted mt-3 mb-0">Indicadores refletem os filtros acima e o status atual. As datas filtram o registro da denúncia, não a data dos relatórios. As filas abaixo filtram somente a lista e suas exportações.</p>
    </div></form>
    <% if (!stats.total) { %><div class="alert alert-info">Nenhuma denúncia encontrada para estes filtros.</div><% } %>
    <section aria-label="Indicadores de denúncias" class="admin-overview">
    <div class="row">
    <% [{label: 'Total de denúncias', key: 'total', queue: '', color: 'primary'}, {label: 'Em aberto', key: 'open', queue: 'open', color: 'warning'}, {label: 'Em andamento', key: 'progress', queue: 'progress', color: 'info'}, {label: 'Finalizadas', key: 'closed', queue: 'closed', color: 'success'}].forEach(card => { %>
        <div class="col-sm-6 col-lg-3 mb-3"><a class="card metric border-<%= card.color %>" href="<%= adminUrl(filters, {queue: card.queue}) %>#denuncias"><div class="card-body text-center"><span class="admin-metric-label"><%= card.label %></span><strong class="admin-metric-value"><%= stats[card.key] %></strong></div></a></div>
    <% }) %>
    </div>
    <p class="small text-muted">Em aberto: registros com status que ainda não estão classificados como finalizados. Os indicadores seguem a classificação definida em Cadastros e cores.</p>
    <section class="card mb-4"><div class="card-header"><h2 class="ui-section-title">Fila de atenção</h2></div><div class="card-body"><div class="row">
        <% [{label:'Abertas sem fiscal', key:'unassigned'}, {label:'Abertas sem relatório há ' + filters.inactivityDays + ' dias', key:'inactive'}, {label:'Abertas há mais de 60 dias', key:'old'}].forEach(item => { %>
        <div class="col-md-4 mb-3"><a class="card metric border-warning" href="<%= adminUrl(filters, {queue: item.key}) %>#denuncias"><div class="card-body text-center"><span class="admin-metric-label"><%= item.label %></span><strong class="admin-metric-value"><%= stats[item.key] %></strong></div></a></div><% }) %>
    </div><p class="small text-muted mb-0">Sem relatório: tempo desde o último relatório ou, quando não há histórico, desde o registro. Estes intervalos são alertas de acompanhamento, não prazos legais.</p></div></section>
    <section class="card mb-4"><div class="card-header"><h2 class="ui-section-title">Carga por fiscal</h2></div><div class="card-body"><p class="text-muted small">Quantidades nos filtros atuais. Fiscais inativos aparecem para permitir identificar trabalho ainda atribuído.</p>
        <div class="table-responsive"><table class="table table-striped table-hover"><thead class="thead-dark"><tr><th>Fiscal</th><th>Abertas</th><th>Sem relatório</th><th>Finalizadas</th><th>Distribuição das abertas</th></tr></thead><tbody>
        <% workload.forEach(user => { %><tr><td><%= user.name %><% if (!user.ativo) { %> <span class="badge badge-secondary">Inativo</span><% } %></td><td><a href="<%= adminUrl(filters,{userId: user.id,queue:'open'}) %>#denuncias"><%= user.open %></a></td><td><a href="<%= adminUrl(filters,{userId:user.id,queue:'inactive'}) %>#denuncias"><%= user.inactive %></a></td><td><a href="<%= adminUrl(filters,{userId:user.id,queue:'closed'}) %>#denuncias"><%= user.closed %></a></td><td><% user.statuses.filter(s => s.count).forEach(s => { %><a class="badge badge-light mr-1" href="<%= adminUrl(filters,{userId:user.id,status:s.slug,queue:'open'}) %>#denuncias"><%= s.label %>: <%= s.count %></a><% }) %></td></tr><% }) %>
        <% if (!workload.length) { %><tr><td colspan="5">Nenhum fiscal cadastrado.</td></tr><% } %>
        </tbody></table></div>
    </div></section>
    <section class="card mb-4" id="denuncias">
        <% const queueLabels = {unassigned:'Abertas sem fiscal',inactive:'Abertas sem relatório',old:'Abertas há mais de 60 dias',closed:'Finalizadas',open:'Em aberto',progress:'Em andamento',age0:'Abertas até 7 dias',age1:'Abertas de 8 a 30 dias',age2:'Abertas de 31 a 60 dias',age3:'Abertas há mais de 60 dias'} %>
        <div class="card-header"><div class="d-flex flex-wrap justify-content-between align-items-center"><h2 class="ui-section-title"><%= queueLabels[filters.queue] || 'Denúncias filtradas' %> <small class="text-muted">(<%= selectedCount %>)</small></h2><div><a class="btn btn-sm btn-outline-secondary" href="<%= adminUrl(filters,{},'/admin/export/csv') %>">Exportar CSV</a> <a class="btn btn-sm btn-outline-secondary" href="<%= adminUrl(filters,{},'/admin/export/pdf') %>">Exportar PDF</a></div></div></div>
        <div class="card-body">
        <% if (filters.queue) { %><a href="<%= adminUrl(filters,{queue:''}) %>#denuncias">Mostrar todas nos filtros atuais</a><% } %>
        <div class="table-responsive"><table class="table table-striped table-hover"><thead class="thead-dark"><tr><th>Protocolo / Denúncia</th><th>Status</th><th>Bairro / Fiscal</th><th>Idade</th><th>Último relatório</th><th>Ações</th></tr></thead><tbody>
        <% selectedRows.forEach(row => { %><tr><td><a href="/denuncias/<%= row.id %>"><b><%= row.number %>/<%= row.year %></b></a><br><%= row.title %></td><td><%- include('../partials/statusBadge.ejs', {status: STATUS[row.status] || {label: 'Sem status reconhecido'}}) %></td><td><%= row.bairro %><br><small><%= row.user?.name || 'Sem fiscal' %></small></td><td><%= row.age %> dias</td><td><%= formatDate(row.last_activity) %><br><small class="<%= row.inactive && isOpen(row) ? 'text-danger' : 'text-muted' %>"><%= row.idleDays %> dias sem relatório</small></td><td><a class="btn btn-sm btn-primary" href="/denuncias/<%= row.id %>">Ver</a><% if (!row.user_id && isOpen(row)) { %> <a class="btn btn-sm btn-primary" href="/admin/assignments?denunciaId=<%= row.id %>">Atribuir</a><% } %></td></tr><% }) %>
        <% if (!selectedRows.length) { %><tr><td colspan="6">Nenhuma denúncia nesta lista.</td></tr><% } %>
        </tbody></table></div>
        <nav class="d-flex align-items-center justify-content-between" aria-label="Paginação de denúncias"><span>Página <%= filters.page %> de <%= pages %></span><div><% if(filters.page > 1) { %><a class="btn btn-sm btn-outline-primary" href="<%= adminUrl(filters,{page:filters.page-1}) %>#denuncias">Anterior</a><% } %> <% if(filters.page < pages) { %><a class="btn btn-sm btn-outline-primary" href="<%= adminUrl(filters,{page:filters.page+1}) %>#denuncias">Próxima</a><% } %></div></nav>
    </div></section>
    <div class="row"><section class="col-lg-6 mb-4"><div class="card h-100"><div class="card-header"><h2 class="ui-section-title">Registros por mês</h2></div><div class="card-body"><p class="small text-muted">Data de registro, com ano e mês. Respeita os filtros gerais.</p><div class="chart-wrap"><canvas id="monthChart" role="img" aria-label="Denúncias registradas por mês"></canvas></div><details class="mt-2"><summary>Ver valores por mês</summary><ul><% monthly.forEach(m => { %><li><%= m.month %>: <%= m.total %></li><% }) %></ul></details></div></div></section>
    <section class="col-lg-6 mb-4"><div class="card h-100"><div class="card-header"><h2 class="ui-section-title">Bairros com mais denúncias</h2></div><div class="card-body"><p class="small text-muted">Os dez maiores volumes nos filtros atuais.</p><div class="chart-wrap"><canvas id="districtChart" role="img" aria-label="Volume de denúncias por bairro"></canvas></div><div class="mt-2"><% bairros.forEach(b => { %><a class="badge badge-light mr-2" href="<%= adminUrl(filters,{bairro:b.bairro,queue:''}) %>#denuncias"><%= b.bairro %>: <%= b.total %></a><% }) %></div></div></div></section></div>
    <div class="row"><section class="col-lg-6 mb-4"><div class="card h-100"><div class="card-header"><h2 class="ui-section-title">Status atual das denúncias</h2></div><div class="card-body"><div class="chart-wrap"><canvas id="statusChart" role="img" aria-label="Distribuição por status"></canvas></div><table class="table table-striped table-hover mt-3"><thead class="thead-dark"><tr><th>Status</th><th>Quantidade</th></tr></thead><tbody><% statusStats.forEach(s => { %><tr><td><%= s.label %></td><td><% if(s.slug) { %><a href="<%= adminUrl(filters,{status:s.slug,queue:''}) %>#denuncias"><%= s.count %></a><% } else { %><%= s.count %><% } %></td></tr><% }) %></tbody></table></div></div></section>
    <section class="col-lg-6 mb-4"><div class="card h-100"><div class="card-header"><h2 class="ui-section-title">Idade das denúncias abertas</h2></div><div class="card-body"><p class="small text-muted">Dias desde o registro, considerando o calendário de São Paulo.</p><% ages.forEach(age => { %><a class="d-flex justify-content-between border-bottom py-3" href="<%= adminUrl(filters,{queue:age.queue}) %>#denuncias"><span><%= age.label %></span><strong><%= age.count %></strong></a><% }) %></div></div></section></div>
    <section class="card mb-4"><div class="card-header"><h2 class="ui-section-title">Últimos relatórios</h2></div><div class="card-body"><p class="small text-muted">Dez relatórios mais recentes das denúncias nos filtros gerais. Um protocolo pode aparecer mais de uma vez.</p><div class="table-responsive"><table class="table table-striped table-hover"><thead class="thead-dark"><tr><th>Data</th><th>Protocolo</th><th>Autor</th><th>Tipo / Resumo</th></tr></thead><tbody>
    <% reports.forEach(report => { %><tr><td><%= formatDate(report.created_at) %></td><td><a href="/denuncias/<%= report.denunciation.id %>"><%= report.denunciation.number %>/<%= report.denunciation.year %></a><br><small><%= report.denunciation.title %></small></td><td><%= report.user?.name || 'Fiscal não disponível' %></td><td><a href="/relatorio/<%= report.id %>"><%- include('../partials/statusBadge.ejs', {status:REPORT_DETAILS[report.type] || {label:'Tipo desconhecido'}}) %></a><br><%= (report.description || '').slice(0,180) %><%= (report.description || '').length > 180 ? '…' : '' %></td></tr><% }) %>
    <% if(!reports.length) { %><tr><td colspan="4">Nenhum relatório encontrado.</td></tr><% } %>
    </tbody></table></div></div></section>
    <script id="admin-chart-data" type="application/json"><%- JSON.stringify({monthly,bairros,statusStats,filters}).replace(/</g, '\\u003c') %></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js" defer></script>
    <script src="/js/admin.js" defer></script>
    <% } %>
</main>
<%- include('../partials/footer.ejs') %>
