<%- include('../partials/header.ejs') %>
<%- include('../partials/navbar.ejs') %>
<link rel="stylesheet" href="/css/auth.css">
<main class="container">
    <%- include('../partials/pageHeading.ejs',{eyebrow:'ADMINISTRATIVO',title:'Usuários e acessos',description:'Gerencie pessoas, credenciais e cargos. As permissões do cargo definem o que cada pessoa pode fazer e se pode receber denúncias.'}) %>
    <%- include('../partials/adminTabs.ejs',{activeTab:'access'}) %>
    <% if(error) { %><div class="alert alert-danger" role="alert"><%= error %></div><% } %>
    <% if(success) { %><div class="alert alert-success" role="status">Alteração salva.</div><% } %>
    <section class="card mb-4"><div class="card-body">
        <h2 class="ui-section-title">E-mail institucional de recuperação</h2>
        <p class="text-muted">Recebe os links de recuperação de todas as contas com autoridade máxima. A alteração invalida os links anteriores.</p>
        <form method="POST" action="/admin/access/email"><div class="form-row">
            <div class="form-group col-md-6"><label for="recovery_email">E-mail do setor</label><input class="form-control" id="recovery_email" type="email" name="email" maxlength="254" required value="<%= setting.recovery_email||'' %>"></div>
            <div class="form-group col-md-6"><label for="email_password">Sua senha atual</label><input class="form-control" id="email_password" type="password" name="current_password" required autocomplete="current-password"></div>
        </div><button class="btn btn-primary">Salvar e-mail</button></form>
    </div></section>
    <div class="access-grid mb-4">
        <section class="card" id="create-access"><div class="card-body"><h2 class="ui-section-title">Criar acesso</h2>
            <form method="POST" action="/admin/access/accounts">
                <div class="form-group"><label for="account_user">Vincular a uma pessoa existente</label><select class="form-control" id="account_user" name="user_id"><option value="">Criar novo cadastro</option><% users.filter(user=>!accounts.some(account=>account.user_id===user.id)).forEach(user=>{ %><option value="<%= user.id %>" <%= selectedUser?.id===user.id?'selected':'' %>><%= user.name %> (#<%= user.id %>)</option><% }) %></select><small class="text-muted">O vínculo preserva as denúncias e os relatórios da pessoa.</small></div>
                <div class="form-group"><label for="account_name">Nome</label><input class="form-control" id="account_name" name="name" required maxlength="255" value="<%= selectedUser?.name||'' %>"></div>
                <div class="form-group"><label for="account_username">Username</label><input class="form-control" id="account_username" name="username" required minlength="3" maxlength="64" pattern="[a-zA-Z0-9._-]+" autocomplete="off"></div>
                <div class="form-group"><label for="account_password">Senha temporária</label><input class="form-control" id="account_password" type="password" name="password" required minlength="15" maxlength="128" autocomplete="new-password"><small class="text-muted">A troca será obrigatória no primeiro acesso.</small></div>
                <div class="form-group"><label for="account_role">Cargo / responsabilidade</label><select class="form-control" id="account_role" name="role_id" required><% roles.forEach(role=>{ %><option value="<%= role.id %>"><%= role.name %> — <%= role.permissions.includes('denunciations.receive')?'recebe denúncias':'não recebe denúncias' %></option><% }) %></select><small class="text-muted">Consulte e edite as permissões de cada cargo abaixo.</small></div>
                <div class="access-permissions"><label><input type="checkbox" name="enabled" checked> Acesso habilitado</label><label><input type="checkbox" name="ativo" <%= !selectedUser||selectedUser.ativo?'checked':'' %>> Cadastro ativo</label></div>
                <button class="btn btn-primary">Criar acesso</button>
            </form>
        </div></section>
        <details class="card access-role"><summary>Criar cargo / responsabilidade</summary><div class="card-body">
            <%- include('../partials/accessRoleForm',{role:null,permissions}) %>
        </div></details>
    </div>
    <section class="mb-4"><h2 class="ui-section-title mb-3">Contas cadastradas (<%= accounts.length %>)</h2>
        <% accounts.forEach(account=>{ const user=users.find(user=>user.id===account.user_id), role=roles.find(role=>role.id===account.role_id); %>
        <details class="card access-account" id="person_<%= account.user_id %>"><summary><%= user?.name||account.username %> <small>— <%= account.username %> · <%= role?.name %> · <%= account.enabled&&user?.ativo?'Acesso ativo':'Acesso inativo' %> · <%= account.enabled&&user?.ativo&&role?.permissions.includes('denunciations.receive')?'Recebe denúncias':'Não recebe novas denúncias' %></small></summary><div class="card-body">
            <div class="access-person-actions"><a class="btn btn-outline-primary" href="/area-fiscal/<%= account.user_id %>?status=ALL">Ver denúncias</a><small class="text-muted">O histórico continua disponível mesmo com o acesso desabilitado.</small></div>
            <form method="POST" action="/admin/access/accounts/<%= account.id %>"><div class="form-row">
                <div class="form-group col-md-4"><label for="name_<%= account.id %>">Nome</label><input class="form-control" id="name_<%= account.id %>" name="name" required maxlength="255" value="<%= user?.name||'' %>"></div>
                <div class="form-group col-md-4"><label for="username_<%= account.id %>">Username</label><input class="form-control" id="username_<%= account.id %>" name="username" required minlength="3" maxlength="64" value="<%= account.username %>"></div>
                <div class="form-group col-md-4"><label for="role_<%= account.id %>">Cargo / responsabilidade</label><select class="form-control" id="role_<%= account.id %>" name="role_id"><% roles.forEach(item=>{ %><option value="<%= item.id %>" <%= item.id===account.role_id?'selected':'' %>><%= item.name %> — <%= item.permissions.includes('denunciations.receive')?'recebe denúncias':'não recebe denúncias' %></option><% }) %></select></div>
            </div><div class="access-permissions"><label><input type="checkbox" name="enabled" <%= account.enabled?'checked':'' %>> Acesso habilitado</label><label><input type="checkbox" name="ativo" <%= user?.ativo?'checked':'' %>> Cadastro ativo</label></div>
            <p class="small text-muted">O cargo define o recebimento de denúncias. Desabilitar o acesso ou o cadastro impede login e novas atribuições, preservando o histórico.</p>
            <button class="btn btn-primary">Salvar acesso</button><small class="text-muted ml-2">Encerra as sessões desta conta.</small></form>
            <hr><form method="POST" action="/admin/access/accounts/<%= account.id %>/reset"><div class="form-group"><label for="reset_<%= account.id %>">Redefinir senha — credencial temporária</label><input class="form-control" id="reset_<%= account.id %>" type="password" name="password" required minlength="15" maxlength="128" autocomplete="new-password"></div><button class="btn btn-outline-primary">Redefinir e exigir troca</button></form>
        </div></details><% }) %>
    </section>
    <section class="mb-4"><h2 class="ui-section-title mb-3">Pessoas sem acesso</h2><p class="text-muted">Cadastros anteriores à migração permanecem vinculados ao histórico. Crie um acesso e escolha um cargo com permissão de recebimento para permitir novas atribuições.</p>
        <% const withoutAccess=users.filter(user=>!accounts.some(account=>account.user_id===user.id)); if(!withoutAccess.length) { %><p class="text-muted">Todas as pessoas cadastradas possuem uma conta.</p><% } %>
        <% withoutAccess.forEach(user=>{ %><details class="card access-account" id="person_<%= user.id %>"><summary><%= user.name %> <small>— Sem acesso · <%= user.ativo?'Cadastro ativo':'Cadastro inativo' %></small></summary><div class="card-body">
            <div class="access-person-actions"><a class="btn btn-outline-primary" href="/area-fiscal/<%= user.id %>?status=ALL">Ver denúncias</a><a class="btn btn-primary" href="/admin/access?user_id=<%= user.id %>#create-access">Criar acesso vinculado</a></div>
            <form method="POST" action="/admin/access/people/<%= user.id %>"><div class="form-group"><label for="person_name_<%= user.id %>">Nome</label><input class="form-control" id="person_name_<%= user.id %>" name="name" required maxlength="255" value="<%= user.name %>"></div><div class="access-permissions"><label><input type="checkbox" name="ativo" <%= user.ativo?'checked':'' %>> Cadastro ativo</label></div><button class="btn btn-primary">Salvar cadastro</button></form>
        </div></details><% }) %>
    </section>
    <section class="mb-4"><h2 class="ui-section-title mb-3">Cargos e permissões</h2><p class="text-muted">As alterações de um cargo valem para todas as pessoas vinculadas a ele. A autoridade máxima administra todos os acessos. Mantenha pelo menos uma Chefia ativa.</p>
        <% roles.forEach(role=>{ %><details class="card access-role mb-3"><summary><%= role.name %><%= role.maximum?' — autoridade máxima':'' %></summary><div class="card-body"><%- include('../partials/accessRoleForm',{role,permissions}) %></div></details><% }) %>
    </section>
    <section class="card"><div class="card-body"><h2 class="ui-section-title">Auditoria — últimos 50 eventos</h2><div class="access-audit"><ul><% audits.forEach(event=>{ %><li><%= new Date(event.createdAt).toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo'}) %> · <strong><%= event.action %></strong> · Responsável: <%= event.actor %><% if(event.target) { %> · Referente a: <%= event.target %><% } %><% if(event.notes) { %><br><small><%= event.notes %></small><% } %></li><% }) %></ul></div></div></section>
</main>
<%- include('../partials/footer.ejs') %>
