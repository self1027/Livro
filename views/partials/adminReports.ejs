    <section class="card mb-4"><div class="card-header"><h2 class="ui-section-title">Últimos relatórios</h2></div><div class="card-body"><p class="small text-muted">Dez relatórios mais recentes das denúncias nos filtros gerais. Um protocolo pode aparecer mais de uma vez.</p><div class="table-responsive"><table class="table table-striped table-hover"><thead class="thead-dark"><tr><th>Data</th><th>Protocolo</th><th>Autor</th><th>Tipo / Resumo</th></tr></thead><tbody>
    <% reports.forEach(report => { %><tr><td><%= formatDate(report.created_at) %></td><td><% if(panelAllowed('denunciations.read')) { %><a href="/denuncias/<%= report.denunciation.id %>"><%= report.denunciation.number %>/<%= report.denunciation.year %></a><% } else { %><%= report.denunciation.number %>/<%= report.denunciation.year %><% } %><br><small><%= report.denunciation.title %></small></td><td><%= report.user?.name || 'Fiscal não disponível' %></td><td><% if(panelCanEditReport(report)) { %><a href="/relatorio/<%= report.id %>"><% } %><%- include('../partials/statusBadge.ejs', {status:REPORT_DETAILS[report.type] || {label:'Tipo desconhecido'}}) %><% if(panelCanEditReport(report)) { %></a><% } %><br><%= (report.description || '').slice(0,180) %><%= (report.description || '').length > 180 ? '…' : '' %></td></tr><% }) %>
    <% if(!reports.length) { %><tr><td colspan="4">Nenhum relatório encontrado.</td></tr><% } %>
    </tbody></table></div></div></section>
