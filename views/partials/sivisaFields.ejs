<% const sivisaValues=locals.sivisaForm||{};
const protocolValues=Array.isArray(sivisaValues.sivisa_protocol)?(sivisaValues.sivisa_protocol.length?sivisaValues.sivisa_protocol:['']):[sivisaValues.sivisa_protocol||''];
const noteValues=Array.isArray(sivisaValues.sivisa_note)?sivisaValues.sivisa_note:[sivisaValues.sivisa_note||'']; %>
<fieldset class="sivisa-fields border rounded p-3 my-3" data-sivisa-fields>
    <legend class="h6 w-auto px-2">Registro da ação no SIVISA</legend>
    <label for="sivisa-state">Situação no SIVISA</label>
    <select class="form-control" id="sivisa-state" name="sivisa_state" data-sivisa-state <%= locals.sivisaRequired?'required':'' %>>
        <option value="">Selecione para o relatório textual</option>
        <% [['pending','Cabe SIVISA — ainda não registrado'],['registered','SIVISA registrado'],['not_applicable','Não cabe SIVISA']].forEach(([value,label])=>{ %><option value="<%= value %>" <%= sivisaValues.sivisa_state===value?'selected':'' %>><%= label %></option><% }) %>
    </select>
    <p class="small text-muted mt-2">O primeiro protocolo remove a pendência. Outros protocolos podem ser adicionados depois. Se o último for removido, a pendência volta. Alterações somente de status não cabem no SIVISA.</p>
    <div data-sivisa-rows>
        <% protocolValues.forEach((protocol,index)=>{ %><div class="border rounded p-3 mb-2" data-sivisa-row>
            <label class="d-block">Protocolo SIVISA<input class="form-control" name="sivisa_protocol" maxlength="64" value="<%= protocol %>" placeholder="01.000917/26" autocomplete="off" data-sivisa-protocol></label>
            <label class="d-block">Observação do protocolo (opcional)<input class="form-control" name="sivisa_note" maxlength="500" value="<%= noteValues[index]||'' %>" placeholder="Ex.: notificação completa neste SIVISA"></label>
            <button type="button" class="btn btn-sm btn-outline-danger" data-sivisa-remove>Remover protocolo</button>
        </div><% }) %>
    </div>
    <button type="button" class="btn btn-sm btn-outline-secondary" data-sivisa-add>Adicionar outro protocolo</button>
    <p class="small text-muted mt-2 mb-0">Cada protocolo pertence a um único relatório. Para marcar “não cabe SIVISA”, deixe a lista vazia.</p>
</fieldset>
