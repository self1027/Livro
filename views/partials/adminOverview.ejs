    <% if (!stats.total) { %><div class="alert alert-info">Nenhuma denúncia encontrada para estes filtros.</div><% } %>
    <section aria-label="Resumo das denúncias" class="admin-overview">
        <div class="row">
        <% [{label:'Denúncias no período',key:'total',queue:'',help:'Total de registros que atendem aos filtros.'},{label:'Em aberto',key:'open',queue:'open',help:'Ainda aguardam conclusão, incluindo as em andamento.'},{label:'Finalizadas',key:'closed',queue:'closed',help:'Estão em um status classificado como finalizado.'}].forEach(card=>{ %>
            <div class="col-md-4 mb-3"><a class="card metric" href="<%= adminUrl(filters,{queue:card.queue}) %>#denuncias"><div class="card-body"><span class="admin-metric-label"><%= card.label %></span><strong class="admin-metric-value"><%= stats[card.key] %></strong><span class="small text-muted d-block mt-2"><%= card.help %></span></div></a></div>
        <% }) %>
        </div>
    </section>
    <section class="card mb-4"><div class="card-header"><h2 class="ui-section-title">Fila de atenção</h2></div><div class="card-body"><div class="row">
        <% [{label:'Abertas sem fiscal', key:'unassigned',help:'Defina quem ficará responsável pelo atendimento.'}, {label:'Abertas sem relatório há ' + filters.inactivityDays + ' dias', key:'inactive',help:'Confira se há atendimento que ainda precisa ser registrado.'}, {label:'Abertas há mais de 60 dias', key:'old',help:'Revise o andamento e os próximos encaminhamentos.'}].forEach(item => { %>
        <div class="col-md-4 mb-3"><a class="card metric border-warning" href="<%= adminUrl(filters, {queue: item.key}) %>#denuncias"><div class="card-body text-center"><span class="admin-metric-label"><%= item.label %></span><strong class="admin-metric-value"><%= stats[item.key] %></strong><span class="small text-muted d-block mt-2"><%= item.help %></span></div></a></div><% }) %>
    </div><p class="small text-muted mb-0">Sem relatório: tempo desde o último relatório ou, quando não há histórico, desde o registro. Uma denúncia pode aparecer em mais de uma fila. São alertas de acompanhamento, não prazos legais.</p></div></section>
    <section class="card mb-4" id="denuncias">
        <% const queueLabels = {unassigned:'Abertas sem fiscal',inactive:'Abertas sem relatório',old:'Abertas há mais de 60 dias',closed:'Finalizadas',open:'Em aberto',progress:'Em andamento',age0:'Abertas até 7 dias',age1:'Abertas de 8 a 30 dias',age2:'Abertas de 31 a 60 dias',age3:'Abertas há mais de 60 dias'} %>
        <div class="card-header"><div class="d-flex flex-wrap justify-content-between align-items-center"><h2 class="ui-section-title"><%= queueLabels[filters.queue] || 'Denúncias filtradas' %> <small class="text-muted">(<%= selectedCount %>)</small></h2><div><a class="btn btn-sm btn-outline-secondary" href="<%= adminUrl(filters,{},'/admin/export/csv') %>">Exportar CSV</a> <a class="btn btn-sm btn-outline-secondary" href="<%= adminUrl(filters,{},'/admin/export/pdf') %>">Exportar PDF</a></div></div></div>
        <div class="card-body">
        <% if (filters.queue) { %><a href="<%= adminUrl(filters,{queue:''}) %>#denuncias">Mostrar todas nos filtros atuais</a><% } %>
        <div class="table-responsive"><table class="table table-striped table-hover"><thead class="thead-dark"><tr><th>Protocolo / Denúncia</th><th>Status</th><th>Bairro / Fiscal</th><th>Último relatório</th><th>Ações</th></tr></thead><tbody>
        <% selectedRows.forEach(row => { %><tr><td><% if(panelAllowed('denunciations.read')) { %><a href="/denuncias/<%= row.id %>"><b><%= row.number %>/<%= row.year %></b></a><% } else { %><b><%= row.number %>/<%= row.year %></b><% } %><br><%= row.title %><br><small class="text-muted">Registrada há <%= row.age %> dias</small></td><td><%- include('../partials/statusBadge.ejs', {status: STATUS[row.status] || {label: 'Sem status reconhecido'}}) %></td><td><%= row.bairro %><br><small><%= row.user?.name || 'Sem fiscal' %></small></td><td><%= formatDate(row.last_activity) %><br><small class="<%= row.inactive && isOpen(row) ? 'text-danger' : 'text-muted' %>"><%= row.idleDays %> dias sem relatório</small></td><td><% if(panelAllowed('denunciations.read')) { %><a class="btn btn-sm btn-primary" href="/denuncias/<%= row.id %>">Ver</a><% } %><% if (panelAllowed('denunciations.assign')&&!row.user_id && isOpen(row)) { %> <a class="btn btn-sm btn-primary" href="/admin/assignments?denunciaId=<%= row.id %>">Atribuir</a><% } %></td></tr><% }) %>
        <% if (!selectedRows.length) { %><tr><td colspan="5">Nenhuma denúncia nesta lista.</td></tr><% } %>
        </tbody></table></div>
        <nav class="d-flex align-items-center justify-content-between" aria-label="Paginação de denúncias"><span>Página <%= filters.page %> de <%= pages %></span><div><% if(filters.page > 1) { %><a class="btn btn-sm btn-outline-primary" href="<%= adminUrl(filters,{page:filters.page-1}) %>#denuncias">Anterior</a><% } %> <% if(filters.page < pages) { %><a class="btn btn-sm btn-outline-primary" href="<%= adminUrl(filters,{page:filters.page+1}) %>#denuncias">Próxima</a><% } %></div></nav>
    </div></section>
